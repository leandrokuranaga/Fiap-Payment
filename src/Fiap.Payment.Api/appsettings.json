{
  "ConnectionStrings": {
    "DefaultConnection": "Server=ec2-54-207-227-213.sa-east-1.compute.amazonaws.com;Database=Fiap-Payment;Uid=root;Pwd=admin;Port=3306;",
    "EventStore": "esdb://ec2-54-207-227-213.sa-east-1.compute.amazonaws.com:2113?tls=false"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://ec2-54-207-227-213.sa-east-1.compute.amazonaws.com:3100",
          "labels": [
            {
              "key": "app",
              "value": "dotnet-api-payment"
            },
            {
              "key": "env",
              "value": "docker"
            }
          ],
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "Payment",
      "Host": "jaeger",
      "Port": 6831,
      "Endpoint": "http://ec2-54-207-227-213.sa-east-1.compute.amazonaws.com:14268/api/traces"
    }
  },
  "ServiceBus": {
    "Region": "sa-east-1",
    "CRMQueueName": "crm-queue",
    "PaymentQueueName": "payment-queue"
  },
  "ExternalServices": {
    "FCGUrl": "https://localhost:5235",
    "CRMUrl": "https://localhost:5235"
  }
}

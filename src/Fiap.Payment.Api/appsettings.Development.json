{
  "ConnectionStrings": {
    "PaymentConnection": "Server=fiap-mysql;Database=Fiap-Payment;Uid=root;Pwd=admin;Port=3306;",
    "EventStore": "esdb://fcg-kurrentdb-1:2113?tls=false"
  },
  "DatadogTracing": {
    "ServiceName": "fiap-payment-api",
    "Environment": "development",
    "Version": "1.0.0",
    "AgentHost": "datadog-agent",
    "AgentPort": 8126,
    "Enabled": true,
    "DebugEnabled": false,
    "AnalyticsEnabled": true,
    "TraceSampleRate": 1.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Datadog": "Information"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Grafana.Loki" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "app",
              "value": "fiap_payment"
            },
            {
              "key": "env",
              "value": "docker"
            }
          ],
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "DistributedTracing": {
    "Jaeger": {
      "ServiceName": "Fiap-Payment",
      "Host": "jaeger",
      "Port": 6831,
      "Endpoint": "http://jaeger:14268/api/traces"
    }
  },
  "ServiceBus": {
    "Region": "sa-east-1",
    "CRMQueueName": "crm-queue",
    "PaymentQueueName": "payment-queue",
    "AccessKey": "***REMOVED***",
    "SecretKey": "***REMOVED***"
  },
  "ExternalServices": {
    "FCGUrl": "http://fiap-app:8080",
    "CRMUrl": "http://fiap-crm:7037"
  },
  "Stripe": {
    "ApiKey": "***REMOVED***",
    "WebhookSecret": "***REMOVED***"
  }
}
